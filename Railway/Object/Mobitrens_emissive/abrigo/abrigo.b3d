;;pillar for Y1;;
[Meshbuilder]
cylinder 14, 0.42, 0.42, 25.100
translate 0.0002,-5.2000, 0.000

;;double V's
[MeshBuilder]
Vertex  0.1, 4.4, 0.0
Vertex  0.1, 5.8, 0.0
Vertex -1.8, 5.8, 0.0
Vertex -1.8, 4.4, 0.0
Face2 0,1,2,3
[Texture]
Load mast_v.bmp
Coordinates 0,0,1
Coordinates 1,0,0
Coordinates 2,-1,0
Coordinates 3,-1,1
Transparent 0,255,0


;;
[MeshBuilder]
Vertex -0.1, 4.4, 0.0
Vertex -0.1, 5.8, 0.0
Vertex  1.8, 5.8, 0.0
Vertex  1.8, 4.4, 0.0
Face2 0,1,2,3
[Texture]
Load mast_v.bmp
Coordinates 0,0,1
Coordinates 1,0,0
Coordinates 2,-1,0
Coordinates 3,-1,1
Transparent 0,255,0



;;pillar for Y2;;
[Meshbuilder]
cylinder 14, 0.42, 0.42, 25.100
translate 0.0002, -5.2000, 12.5000
color 195,195,195

;;double V's
[MeshBuilder]
Vertex   0.1, 4.4, 12.50
Vertex   0.1, 5.8, 12.50
Vertex  -1.8, 5.8, 12.50
Vertex  -1.8, 4.4, 12.50
Face2 0,1,2,3
[Texture]
Load mast_v.bmp
Coordinates 0,0,1
Coordinates 1,0,0
Coordinates 2,-1,0
Coordinates 3,-1,1
Transparent 0,255,0

