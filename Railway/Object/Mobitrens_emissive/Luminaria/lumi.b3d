; lamp.b3d — LED fria (teste sem texturas)
; Sintaxe INI-style B3D: [MeshBuilder], Cylinder, Color, EmissiveColor, BlendMode

; =========================
; 1) TUBO LED (cilindro pequeno)
; =========================
[MeshBuilder]
; 16 lados, raio 0.06, altura 1.20m
Cylinder 16,0.06,0.06,1.20
; sobe pro teto (você posiciona na rota depois; aqui é relativo ao objeto)
Translate 0,0,0
Color 235,245,255
EmissiveColor 200,220,255
BlendMode Additive,80,DivideExponent2

; =========================
; 2) CONE DE LUZ (tronco de cone)
; =========================
[MeshBuilder]
; 16 lados, topo pequeno, base grande, altura 2.50m
Cylinder 16,0.12,0.95,2.50
; coloca abaixo do tubo (o topo do cone encosta na lâmpada)
Translate 0,-0.10,0
Color 235,245,255
EmissiveColor 90,120,180
BlendMode Additive,140,DivideExponent2

; ---- cone invertido pra ficar “double-sided” (não sumir ao chegar perto)
[MeshBuilder]
Cylinder 16,0.12,0.95,2.50
Translate 0,-0.10,0
; espelha pra inverter as faces (double-sided na marra)
Scale -1,1,1
Color 235,245,255
EmissiveColor 90,120,180
BlendMode Additive,140,DivideExponent2

; =========================
; 3) DISCO NO CHÃO (mancha de luz)
; =========================
[MeshBuilder]
; um “cilindro baixinho” vira um disco
Cylinder 20,1.10,1.10,0.02
Translate 0,-2.55,0
Color 235,245,255
EmissiveColor 60,80,120
BlendMode Additive,160,DivideExponent2

; ---- disco invertido também (pra não sumir dependendo do ângulo)
[MeshBuilder]
Cylinder 20,1.10,1.10,0.02
Translate 0,-2.55,0
Scale -1,1,1
Color 235,245,255
EmissiveColor 60,80,120
BlendMode Additive,160,DivideExponent2

