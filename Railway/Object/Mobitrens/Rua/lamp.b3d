[MeshBuilder]
cube 0.2,0.1,0.2
Color 200,255,200
translate 5.5,7.8,0
emissivecolor 255, 255, 255

[MeshBuilder]
; Tapete como PLANO (4 vértices + 1 face), não cube
Vertex -5, 0, -17,  0, 1, 0
Vertex  5, 0, -17,  0, 1, 0
Vertex  5, 0,  17,  0, 1, 0
Vertex -5, 0,  17,  0, 1, 0
Face2 0, 1, 2, 3

Translate 5, 0.21, 5
Color 190,200,180,125
EmissiveColor 140,180,140


[Texture]
Load light_spill.png
Coordinates 0, 0, 0
Coordinates 1, 1, 0
Coordinates 2, 1, 1
Coordinates 3, 0, 1

[MeshBuilder]
; Halo vertical da lâmpada (plano em pé)
Vertex -1.45, -1.45, 0,   0, 0, 1
Vertex  1.45, -1.45, 0,   0, 0, 1
Vertex  1.45,  1.45, 0,   0, 0, 1
Vertex -1.45,  1.45, 0,   0, 0, 1
Face2 0, 1, 2, 3

; posição = exatamente onde está a lâmpada
Translate 5.5, 7.8, 0

Color 255,255,255,90
EmissiveColor 255,255,255

[Texture]
Load light_spill.png
Coordinates 0, 0, 0
Coordinates 1, 1, 0
Coordinates 2, 1, 1
Coordinates 3, 0, 1

BlendMode Additive, 4

