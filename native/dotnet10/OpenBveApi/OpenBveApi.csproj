<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OpenBveApi</AssemblyName>
    <RootNamespace>OpenBveApi</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);SYSLIB0051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" Exclude="src/Textures/Textures.BitmapOrigin.cs;src/**/obj/**/*.cs;&#xA;src/**/bin/**/*.cs" />
  </ItemGroup>


  <!-- Contratos WCF do proxy Win32: portabilidade pendente -->
  <ItemGroup>
    <Compile Remove="src/System/Interop.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="src/**/*.resx" />
    <EmbeddedResource Include="../../../source/OpenBveApi/Resource.resx">
      <Link>Resource.resx</Link>
      <LogicalName>OpenBveApi.Resource.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="CS-Script" Version="4.14.11" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="Ude.NetStandard" Version="1.2.0" />
  </ItemGroup>

</Project>
